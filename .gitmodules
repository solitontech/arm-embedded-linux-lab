[submodule "shared/boot/u-boot"]
	path = shared/boot/u-boot
	url = https://github.com/u-boot/u-boot.git
	branch = v2024.07
[submodule "shared/rootfs/busybox"]
	path = shared/rootfs/busybox
	url = https://github.com/mirror/busybox.git
	branch = 1_36_stable
[submodule "shared/kernel/rpi-linux"]
	path = shared/kernel/rpi-linux
	url = https://github.com/raspberrypi/linux.git
	branch = rpi-6.18.y
[submodule "shared/buildroot/buildroot"]
	path = shared/buildroot/buildroot
	url = https://github.com/buildroot/buildroot.git
