# Build & Binary Artifacts
*.o
*.ko
*.so
*.a
*.img

# BSP binaries in shared/bsp/ ARE committed (small firmware blobs + DTBs)
# Only ignore large generated binaries from build trees
shared/boot/build/**/*.bin
shared/boot/build/**/*.elf

# Linux / Kernel / U-Boot build trees
build/
output/
shared/boot/build/
# shared/boot/firmware/ — replaced by shared/bsp/ (committed)
shared/boot/firmware/
.config
.config.old
# Kernel build command files (not U-Boot boot scripts)
shared/boot/build/**/*.cmd
modules.order
Module.symvers

# nfs rootfs — runtime and generated files (never commit boot/runtime artifacts)
nfs/*-rootfs/**/.ash_history
nfs/rpi4-rootfs/etc/dropbear/*_host_key
nfs/*-rootfs/var/
nfs/*-rootfs/tmp/
nfs/*-rootfs/run/
nfs/*-rootfs/dev/urandom
nfs/*-rootfs/root/.ssh/
nfs/*-rootfs/**/*.pid
nfs/*-rootfs/**/utmp
nfs/*-rootfs/**/wtmp
nfs/*-rootfs/**/*.log
nfs/*-rootfs/**/*.pub
nfs/*-rootfs/etc/wpa_supplicant/

# IDE & Editor files
.vscode/
.idea/
*.swp
*~
.DS_Store

# Python Cache
__pycache__/
*.py[cod]
*$py.class

# Local TFTP staging/server directory
tftp/*
!tftp/.gitkeep
!tftp/test.txt

# Lab environment secrets (real IPs, SSH key paths — copy from *.env.example)
tools/target/lab_host.env
shared/boards/*.env

# MCP server — virtual environment, runtime logs, and generated service file
tools/mcp/venv/
tools/mcp/logs/*.log
tools/mcp/lab-mcp.service

# EEPROM tool — downloaded firmware and generated binaries
tools/eeprom/output/

# Buildroot & large output trees
buildroot/output/

# Runtime services & source clones
dnsmasq.log
shared/rootfs/dropbear/
