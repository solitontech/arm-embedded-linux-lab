# Build & Binary Artifacts
*.o
*.ko
*.so
*.a
*.img

# Linux / Kernel / U-Boot build trees
build/
output/
shared/boot/build/
shared/boot/firmware/
shared/kernel/build/
.config
.config.old
modules.order
Module.symvers

# NFS rootfs — ignore all modules except committed camera drivers
shared/nfs/*/lib/modules/
!shared/nfs/*/lib/modules/*/kernel/
!shared/nfs/*/lib/modules/*/kernel/drivers/
!shared/nfs/*/lib/modules/*/kernel/drivers/media/
!shared/nfs/*/lib/modules/*/kernel/drivers/media/**
shared/nfs/*-rootfs/**/.ash_history
shared/nfs/rpi4-rootfs/etc/dropbear/*_host_key
shared/nfs/*-rootfs/var/
shared/nfs/*-rootfs/tmp/
shared/nfs/*-rootfs/run/
shared/nfs/*-rootfs/dev/urandom
shared/nfs/*-rootfs/root/.ssh/
shared/nfs/*-rootfs/**/*.pid
shared/nfs/*-rootfs/**/utmp
shared/nfs/*-rootfs/**/wtmp
shared/nfs/*-rootfs/**/*.log
shared/nfs/*-rootfs/**/*.pub
shared/nfs/*-rootfs/etc/wpa_supplicant/
shared/nfs/*-rootfs/usr/local/
shared/nfs/*-rootfs/usr/bin/vision-edge

# TFTP — deployed artifacts served by Docker
tftp/*
!tftp/.gitkeep

# IDE & Editor files
.vscode/
.idea/
.devin/
*.swp
*~
.DS_Store

# clangd / LSP tooling (machine-specific, generated per-developer)
compile_commands.json
.clangd-cache/
.cache/

# Python Cache
__pycache__/
*.py[cod]
*$py.class

# Lab environment secrets (real IPs, SSH key paths — copy from *.env.example)
tools/target/lab_host.env
shared/boards/*.env

# MCP server — virtual environment, runtime logs, and generated service file
tools/mcp/venv/
tools/mcp/logs/*.log
tools/mcp/lab-mcp.service

# EEPROM tool — downloaded firmware and generated binaries
tools/eeprom/output/

# Buildroot & large output trees
buildroot/output/

# Runtime services & source clones
dnsmasq.log
shared/rootfs/dropbear/
