# VisionEdge Production Defconfig — Raspberry Pi 4 (BCM2711)
# Target: minimal SquashFS rootfs < 25 MB, sub-2.5s cold boot
#
# Usage:
#   cd <buildroot-source>
#   make BR2_EXTERNAL=<path-to-this-dir>/.. visiond_rpi4_defconfig
#   make -j$(nproc)

# Target architecture
BR2_aarch64=y
BR2_cortex_a72=y

# Toolchain — let Buildroot build its own (avoids distribution toolchain issues)
BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# System configuration
BR2_TARGET_GENERIC_HOSTNAME="visiond"
BR2_TARGET_GENERIC_ISSUE="VisionEdge Industrial Gateway"
BR2_SYSTEM_BIN_SH="busybox"
BR2_INIT_BUSYBOX=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_ROOT_PASSWD=""

# /dev management
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y

# Filesystem — SquashFS only (read-only, power-loss resilient)
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# BR2_TARGET_ROOTFS_EXT2 is not set
# BR2_TARGET_ROOTFS_TAR is not set

# Rootfs overlay — init scripts, fstab, visiond binary placeholder
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_VISIOND_PATH)/overlay"

# Packages — minimal
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# Strip and minimize
BR2_STRIP_strip=y
BR2_OPTIMIZE_2=y
BR2_ENABLE_LOCALE=n
