#!/bin/sh
# /etc/init.d/rcS - System startup script

# Create essential device nodes before devtmpfs is mounted.
# The kernel needs /dev/console to exist at the point it hands off to init.
# These are immediately shadowed once devtmpfs is mounted below.
[ -e /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -e /dev/null ]    || mknod -m 666 /dev/null    c 1 3

# Mount pseudo filesystems
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts

exec >/dev/ttyS0 2>&1

printf '%s\r\n' '=========================================================='
printf '%s\r\n' ' Welcome to Soliton ARM Embedded Linux Lab'
printf ' Kernel: %s on %s\r\n' "$(uname -r)" "$(uname -m)"
printf '%s\r\n' '=========================================================='