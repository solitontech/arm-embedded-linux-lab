# ==============================================================================
# Raspberry Pi 4 — Board Profile
# Copy to shared/boards/rpi4.env and adjust for your lab setup.
# .env files are git-ignored — they hold local lab-specific configs.
#
# Quick start:
#   cp shared/boards/rpi4.env.example shared/boards/rpi4.env
# ==============================================================================

# Target Network & SSH
TARGET_IP="192.168.1.150"
TARGET_USER="root"
TARGET_PORT="22"
TARGET_SSH_KEY=""
TARGET_DEST_DIR="/usr/local/bin"

# Target Serial & Console
BOARD_SERIAL_PORT="/dev/ttyUSB0"
BOARD_SERIAL_BAUD="115200"

# Target Reset & Reboot
# Methods: uboot_serial | ssh | sysrq_serial | power_relay
BOARD_RESET_METHOD="uboot_serial"
BOARD_RESET_CMD="reset\r"

# Target TFTP & NFS paths
BOARD_TFTP_SUBDIR="rpi4"
BOARD_NFS_ROOTFS="rpi4-rootfs"

# Remote GDB Port
GDB_PORT="2345"

# Host Network (used by ./lab docker run for DHCP/TFTP/NFS)
# Set these to enable dnsmasq DHCP inside Docker for EEPROM netboot.
HOST_INTERFACE=""
HOST_IP=""

# Wi-Fi (optional — used by tools/target/configure_wifi.sh)
# WIFI_SSID=""
# WIFI_PSK=""
# WIFI_COUNTRY="US"
