# ==============================================================================
# Board Profile: Raspberry Pi 3 Model B+ / Zero 2W — EXAMPLE
# Copy this file to tools/deploy/boards/rpi3.env and update for your lab setup.
# ==============================================================================

TARGET_IP="192.168.1.151"
TARGET_USER="root"
TARGET_PORT="22"
TARGET_SSH_KEY="~/.ssh/id_rsa"
TARGET_DEST_DIR="/usr/local/bin"

BOARD_SERIAL_PORT="/dev/ttyUSB1"
BOARD_SERIAL_BAUD="115200"

BOARD_RESET_METHOD="uboot_serial"
BOARD_RESET_CMD="reset\r"

BOARD_TFTP_SUBDIR="rpi3"
BOARD_NFS_ROOTFS="rpi3/rootfs"

GDB_PORT="2346"
