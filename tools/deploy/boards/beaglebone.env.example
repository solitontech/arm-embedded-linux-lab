# ==============================================================================
# Board Profile: BeagleBone Black — EXAMPLE
# Copy this file to tools/deploy/boards/beaglebone.env and update for your lab setup.
# ==============================================================================

TARGET_IP="192.168.1.152"
TARGET_USER="debian"
TARGET_PORT="22"
TARGET_SSH_KEY="~/.ssh/id_rsa"
TARGET_DEST_DIR="/home/debian/bin"

BOARD_SERIAL_PORT="/dev/ttyUSB2"
BOARD_SERIAL_BAUD="115200"

BOARD_RESET_METHOD="uboot_serial"
BOARD_RESET_CMD="reset\r"

BOARD_TFTP_SUBDIR="beaglebone"
BOARD_NFS_ROOTFS="beaglebone/rootfs"

GDB_PORT="2347"
