# ==============================================================================
# Board Profile: Raspberry Pi 4 Model B — EXAMPLE
# Copy this file to tools/deploy/boards/rpi4.env and update for your lab setup.
# boards/*.env files are git-ignored and should NEVER be committed.
# ==============================================================================

# Target Network & SSH
TARGET_IP="192.168.1.150"
TARGET_USER="root"
TARGET_PORT="22"
TARGET_SSH_KEY="~/.ssh/id_rsa"
TARGET_DEST_DIR="/usr/local/bin"

# Target Serial & Console
BOARD_SERIAL_PORT="/dev/ttyUSB0"
BOARD_SERIAL_BAUD="115200"

# Target Reset & Reboot
# Methods: uboot_serial | ssh | sysrq_serial | power_relay
BOARD_RESET_METHOD="uboot_serial"
BOARD_RESET_CMD="reset\r"

# Target TFTP & NFS paths (relative to TFTP_BASE_DIR / NFS_BASE_DIR)
BOARD_TFTP_SUBDIR="rpi4"
BOARD_NFS_ROOTFS="rpi4/rootfs"

# Remote GDB Port
GDB_PORT="2345"
