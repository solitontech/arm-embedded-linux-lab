# ==============================================================================
# Board Profile: QEMU ARM64 Emulation — EXAMPLE
# Copy this file to tools/deploy/boards/qemu_arm64.env and update for your setup.
# ==============================================================================

TARGET_IP="127.0.0.1"
TARGET_USER="root"
TARGET_PORT="2222"
TARGET_SSH_KEY="~/.ssh/id_rsa"
TARGET_DEST_DIR="/usr/local/bin"

BOARD_SERIAL_PORT=""
BOARD_SERIAL_BAUD="115200"

BOARD_RESET_METHOD="ssh"
BOARD_RESET_CMD="reboot\n"

BOARD_TFTP_SUBDIR="qemu_arm64"
BOARD_NFS_ROOTFS="qemu_arm64/rootfs"

GDB_PORT="1234"
