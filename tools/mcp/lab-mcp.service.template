[Unit]
Description=ARM Embedded Linux Lab MCP Server (Hardware Tool Bridge)
After=network.target

[Service]
Type=simple
WorkingDirectory={{REPO_PATH}}
ExecStart={{REPO_PATH}}/tools/mcp/venv/bin/python {{REPO_PATH}}/tools/mcp/server.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
