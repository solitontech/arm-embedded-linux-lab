[Unit]
Description=ARM Embedded Linux Lab MCP Server (Hardware Tool Bridge)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/soliton/source/repo/nirmalprasad.k/arm-embedded-linux-lab
ExecStart=/home/soliton/source/repo/nirmalprasad.k/arm-embedded-linux-lab/tools/mcp/venv/bin/python /home/soliton/source/repo/nirmalprasad.k/arm-embedded-linux-lab/tools/mcp/server.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
